# ==============================================================================
# VIGILORA — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# This template documents all required and optional environment variables for the
# VIGILORA platform. Copy this file to '.env.local' for local development:
#
#   cp .env.example .env.local
#
# IMPORTANT SECURITY RULES:
# - NEVER commit '.env.local' or any file containing real credentials to Git.
# - Do NOT replace these placeholder values inside this '.env.example' file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS CLOUD INFRASTRUCTURE (Required for Live Telemetry & Evidence)
# ------------------------------------------------------------------------------
# AWS Region hosting DynamoDB tables and S3 evidence bucket
AWS_REGION=eu-north-1

# Single-table design partition for campus operations
DYNAMODB_TABLE=VIGILORA-Main

# Private S3 bucket for encrypted photo evidence uploads (Option A Presigned POST)
# REQUIRED in production. If missing in production, the application will throw a configuration error.
S3_BUCKET=vigilora-evidence-YOUR_ACCOUNT_ID-eu-north-1-an

# Default multi-tenant campus partition key (Format: "CAMPUS#<CAMPUS_CODE>")
VIGILORA_CAMPUS_ID="CAMPUS#METROPOLIS"

# Standard AWS IAM Credentials (Optional if running on EC2/ECS/Lambda with IAM roles
# or if logged in via AWS CLI 'aws configure' / 'aws login')
# AWS_ACCESS_KEY_ID=your-aws-access-key-id
# AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
# AWS_SESSION_TOKEN=your-optional-sts-session-token

# ------------------------------------------------------------------------------
# 2. INTELLIGENT INCIDENT AUTO-TRIAGE (Optional AI Provider)
# ------------------------------------------------------------------------------
# Google Gemini API key for external LLM triage classification.
# If omitted, VIGILORA automatically falls back to its deterministic,
# calibrated NLP semantic classification engine with sub-second response times.
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 3. DIRECT ROLE SELECTION ACCESS CONTROLS (Hackathon Evaluation)
# ------------------------------------------------------------------------------
# In production (NODE_ENV=production), demo station role selection is disabled
# by default. Set to 'true' if deploying a live demonstration instance for judges.
# Allows direct selection among 3 operational roles: Lead Dispatcher, Field Responder, Campus Administrator.
ENABLE_DEMO_LOGIN=false

# ------------------------------------------------------------------------------
# 4. APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# Node.js execution environment ('development' | 'production' | 'test')
NODE_ENV=development

